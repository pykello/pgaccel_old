+TEST(CompactColumn, SelectedSignedExtremesAtEveryStoredWidth) {
+    Int64Type logical;
+    for (int width:{1,2,4,8}) for (int count:{1,7,8,15,16,17,63,64,65}) {
+        int64_t low=width==8?INT64_MIN:-(int64_t(1)<<(width*8-1));
+        int64_t high=width==8?INT64_MAX:(int64_t(1)<<(width*8-1))-1;
+        std::vector<int64_t> values(2*count+1,0);
+        std::vector<uint16_t> rows;
+        for(int i=0;i<count;++i) {
+            rows.push_back(2*i+1); values[2*i+1]=i%2?high:low;
+        }
+        auto input=test::Raw(values,width);
+        auto compact=CompactNativeColumn(*input,logical,rows);ASSERT_TRUE(compact.ok());
+        auto raw=static_cast<RawColumnData<Int64Type>*>((*compact).get());
+        EXPECT_EQ(raw->minValue,low);EXPECT_EQ(raw->maxValue,count==1?low:high);
+        std::stringstream saved;ASSERT_TRUE(raw->Save(saved).ok());
+        auto loaded=ColumnDataBase::Load(saved,&logical);ASSERT_TRUE(loaded.ok());
+    }
+}
