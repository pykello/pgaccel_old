 #include "column_data.hpp"
 #include <limits>
 
 namespace pgaccel
 {
 
+namespace {
+using ProfileClock=std::chrono::steady_clock;
+uint64_t ProfileElapsed(ProfileClock::time_point start) {
+    return std::chrono::duration_cast<std::chrono::nanoseconds>(ProfileClock::now()-start).count();
+}
+struct StringLoadProfile {
+    std::atomic<uint64_t> total{0},decode{0},codes{0},entries{0};
+    ~StringLoadProfile(){std::fprintf(stderr,"STRING_PROFILE total_ms=%.3f decode_ms=%.3f codes_ms=%.3f entries=%llu\n",total.load()/1e6,decode.load()/1e6,codes.load()/1e6,(unsigned long long)entries.load());}
+} stringLoadProfile;
+}
 template<>
 Result<bool>
 DictColumnData<StringType>::SaveValue(std::ostream &out,
@@ -50,6 +63,7 @@ template<class AccelTy>
 static Result<ColumnDataP>
 LoadDictColumnData(std::istream &in, bool aligned)
 {
+    auto totalStart=ProfileClock::now();
     int dictSize = 0;
     auto result = std::make_shared<DictColumnData<AccelTy>>();
     result->type = ColumnDataBase::DICT_COLUMN_DATA;
@@ -59,8 +73,13 @@ LoadDictColumnData(std::istream &in, bool aligned)
     // The validated count fixes storage before decoding. Construct strings
     // directly in their final slots, avoiding temporary heap allocations and
     // copies; numeric dictionaries can be read as one contiguous block.
+    auto decodeStart=ProfileClock::now();
     result->dict.resize(dictSize);
     ReadValues<AccelTy>(in, dictSize, result->dict.data());
+    if constexpr(std::is_same_v<AccelTy,StringType>) {
+        stringLoadProfile.decode+=ProfileElapsed(decodeStart);
+        stringLoadProfile.entries+=dictSize;
+    }
 
     in.read((char *) &result->size, sizeof(result->size));
     if (!in || result->size < 0 || result->size > RowGroupSize || (result->size && !dictSize))
@@ -77,6 +96,7 @@ LoadDictColumnData(std::istream &in, bool aligned)
     if (!in) return Status::Invalid("Truncated column data");
     // Byte stores avoid a dependent read/modify/write of a packed bit for
     // every code. This scratch array is bounded by one stripe dictionary.
+    auto codesStart=ProfileClock::now();
     std::vector<uint8_t> used(dictSize,0);
     for (int i = 0; i < result->size; ++i) {
         int code = bytesPerValue == 1 ? result->values[i] : ((uint16_t*)result->values)[i];
@@ -85,6 +105,10 @@ LoadDictColumnData(std::istream &in, bool aligned)
     }
     if (std::find(used.begin(),used.end(),uint8_t(0)) != used.end())
         return Status::Invalid("Native dictionary contains unused values");
+    if constexpr(std::is_same_v<AccelTy,StringType>) {
+        stringLoadProfile.codes+=ProfileElapsed(codesStart);
+        stringLoadProfile.total+=ProfileElapsed(totalStart);
+    }
     ColumnDataP resultCasted = std::move(result);
     return resultCasted;
 }
